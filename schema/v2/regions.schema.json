{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timechorus.com/schema/v2/regions.schema.json",
  "title": "regions",
  "description": "Regions of the axial corpus; the top-level geographic and cultural division.",
  "type": "object",
  "required": [
    "id",
    "name_en",
    "pillar",
    "colour",
    "description"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name_en": {
      "type": "string"
    },
    "pillar": {
      "type": "string"
    },
    "colour": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "name_zh": {
      "type": "string",
      "description": "Optional. The region's Simplified Chinese name: ruled text (owner-approved), Han characters only. Blank means no zh name; the engine then falls back to name_en."
    }
  },
  "x-timechorus": {
    "table": "regions",
    "idField": "id",
    "keyFields": null,
    "checks": [
      {
        "rule": "procedural",
        "name": "regions_name_zh"
      }
    ]
  }
}
